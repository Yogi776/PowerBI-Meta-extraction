          {
            "type": "calculated",
            "name": "Calc Enterprise Flag",
            "dataType": "string",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "expression": "mid(ArCustomer[Customer],11,1)"
          },
          {
            "type": "calculated",
            "name": "Calc MSA",
            "dataType": "string",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "expression": "if(isblank(LOOKUPVALUE('Metro Key'[MSA],'Metro Key'[ZipCode],ArCustomer[ShipPostalCode])),LOOKUPVALUE('Metro Key'[MSA],'Metro Key'[ZipCode],ArCustomer[SoldPostalCode]),LOOKUPVALUE('Metro Key'[MSA],'Metro Key'[ZipCode],ArCustomer[ShipPostalCode]))"
          },
          {
            "type": "calculated",
            "name": "Calc SalesForce Customer",
            "dataType": "string",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "expression": "right(ArCustomer[Customer],7)"
          },
          {
            "type": "calculated",
            "name": "Calc SubKey",
            "dataType": "string",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "expression": "lookupvalue(Account[Sub_Key_Account__c],Account[AccountNumber],ArCustomer[Calc SalesForce Customer])"
          },
          {
            "type": "calculated",
            "name": "Calc VA/VOSB",
            "dataType": "string",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "expression": "if(ArCustomer[Channel]=\"VA\",\"VA\",if(ArCustomer[Calc VOSB]=TRUE,\"VOSB\",\"Non-VA/VOSB\"))"
          },
          {
            "type": "calculated",
            "name": "Calc VOSB",
            "dataType": "boolean",
            "isDataTypeInferred": true,
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "expression": "LOOKUPVALUE(Account[VOSB__c],Account[AccountNumber],ArCustomer[Calc SalesForce Customer])"
          },
          {
            "type": "calculated",
            "name": "Channel Description",
            "dataType": "string",
