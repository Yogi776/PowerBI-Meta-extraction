      {
        "name": "GL Naming",
        "partitions": [
          {
            "name": "GL Naming",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#\"GL Code\" = _t, #\"Visual_GL Name\" = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"GL Code\", Int64.Type}, {\"Visual_GL Name\", type text}})",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "columns": [
          {
            "name": "GL Code",
            "dataType": "int64",
            "sourceColumn": "GL Code",
            "formatString": "0",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Visual_GL Name",
            "dataType": "string",
            "sourceColumn": "Visual_GL Name",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ]
      },
