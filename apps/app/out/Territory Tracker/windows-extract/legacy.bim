      {
        "name": "ArTrnDetail",
        "partitions": [
          {
            "name": "ArTrnDetail",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(\"nausawsdb004.harmar.lan\", \"Harmar\"),",
                "    dbo_ArTrnDetail = Source{[Schema=\"dbo\",Item=\"ArTrnDetail\"]}[Data],",
                "    #\"Filtered Rows\" = Table.SelectRows(dbo_ArTrnDetail, each [TrnYear] > 2022),",
                "    #\"Merged Queries\" = Table.NestedJoin(#\"Filtered Rows\", {\"Customer\"}, #\"ArCustomer+\", {\"Customer\"}, \"ArCustomer+\", JoinKind.LeftOuter),",
                "    #\"Expanded ArCustomer+\" = Table.ExpandTableColumn(#\"Merged Queries\", \"ArCustomer+\", {\"Membership\"}, {\"ArCustomer+.Membership\"}),",
                "    #\"Merged Queries1\" = Table.NestedJoin(#\"Expanded ArCustomer+\", {\"StockCode\"}, #\"4  Set Stock Code Dimensions\", {\"StockCode\"}, \"4  Set Stock Code Dimensions\", JoinKind.LeftOuter),",
                "    #\"Expanded 4  Set Stock Code Dimensions\" = Table.ExpandTableColumn(#\"Merged Queries1\", \"4  Set Stock Code Dimensions\", {\"Unit Type\", \"Product Branch\", \"Product Category\", \"Product Line\", \"Family\", \"Model\"}, {\"4  Set Stock Code Dimensions.Unit Type\", \"4  Set Stock Code Dimensions.Product Branch\", \"4  Set Stock Code Dimensions.Product Category\", \"4  Set Stock Code Dimensions.Product Line\", \"4  Set Stock Code Dimensions.Family\", \"4  Set Stock Code Dimensions.Model\"}),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Expanded 4  Set Stock Code Dimensions\",{\"AdmAltTax\", \"AdmTax\", \"AdmTaxCertXref\", \"AdmTaxExt\", \"AdmTaxFltrPcls\", \"ArCstStkPrc\", \"ArCustomer\", \"ArCustomerBal\", \"ArInvoice\", \"ArInvoiceReference\", \"ArPermReprint\", \"ArRegisterRef\", \"ArSalesMove\", \"ArTaxSuspHeader\", \"ArTrnGst(TrnYear,TrnMonth,Register,Invoice,SummaryLine,DetailLine)\", \"ArTrnGst(TrnYear,TrnMonth,Register,Invoice,SummaryLine,DetailLine) 2\", \"ArTrnSummary\", \"ArTrnTax\", \"ArTrnTaxCode\", \"ArTrnTaxCodeUkVat\", \"ArTrnTaxUkVat\", \"AssetBranch\", \"EccDrawStock\", \"EccRevHistory\", \"EccRevHistoryCost\", \"GenJournalCtl\", \"GenJournalRef\", \"IntEdiInvExtra\", \"IntEdiInvHdr\", \"InvMaster\", \"InvMultBin\", \"InvPrice\", \"InvStockTake\", \"InvWarehouse\", \"InvWhBin\", \"InvWhControl\", \"InvWhatIfCost\", \"IopProxies\", \"IopWarehouse\", \"PosDeposit\", \"RtsLastPrice\", \"SalArea\", \"SalBranch\", \"SalBranchExt\", \"SalBudgetCust\", \"SalBudgetProdClass\", \"SalGlIntPayment\", \"SalGlIntSale\", \"SalProductClass\", \"SalProductClassDes\", \"SalProductClassSum\", \"SalSalesperson\", \"SalSalespersonSum\", \"SorDetail\", \"SorDetailRep\", \"SorDiscCusQty\", \"SorLoadSoHeader\", \"SorMaster\", \"SorMasterRep\", \"SorUsaTaxRep\", \"TblSoBuyingGroup\", \"TblSoTypes\", \"TblSoXrfPrcCur\", \"WhmBin\", \"WipBranch\"})",
                "in",
                "    #\"Removed Columns\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ],
        "measures": [
          {
            "name": "% VA/VOSB"
          },
          {
            "name": "B(W)",
            "formatString": "#,###;(#,###)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "sum(ArTrnDetail[2025 Visual Qty])-SUM(ArTrnDetail[2023 Visual Qty])"
          },
          {
            "name": "Calc 2023 Folding Rail Attachment Rate",
            "formatString": "#.#%;(#.#%)'",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "(calculate(sum(ArTrnDetail[2023 All Qty]),'4  Set Stock Code Dimensions'[Key Feature]=\"Folding Rail\"))/calculate(sum(ArTrnDetail[2024 Visual Qty]),'4  Set Stock Code Dimensions'[Product Class Description]=\"Pinnacle SL\")"
          },
          {
            "name": "Calc 2023 Swing Away Attachment Rate",
            "formatString": "#.#%;(#.#%)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "(calculate(sum(ArTrnDetail[2023 All Qty]),'4  Set Stock Code Dimensions'[Family]=\"Swing Away\"))/calculate(sum(ArTrnDetail[2024 Visual Qty]),OR('4  Set Stock Code Dimensions'[ProductClass]=\"MOAL\",'4  Set Stock Code Dimensions'[ProductClass]=\"MOHD\"))"
          },
          {
            "name": "Calc 2024 Folding Rail Attachment Rate",
            "formatString": "#.#%;(#.#%)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "(calculate(sum(ArTrnDetail[2024 All Qty]),'4  Set Stock Code Dimensions'[Key Feature]=\"Folding Rail\"))/calculate(sum(ArTrnDetail[2025 Visual Qty]),'4  Set Stock Code Dimensions'[Product Class Description]=\"Pinnacle SL\")"
          },
          {
            "name": "Calc 2024 Swing Away Attachment Rate",
            "formatString": "0.0%;-0.0%;0.0%",
            "expression": "(calculate(sum(ArTrnDetail[2024 All Qty]),'4  Set Stock Code Dimensions'[Family]=\"Swing Away\"))/calculate(sum(ArTrnDetail[2025 Visual Qty]),OR('4  Set Stock Code Dimensions'[ProductClass]=\"MOAL\",'4  Set Stock Code Dimensions'[ProductClass]=\"MOHD\"))"
          },
          {
            "name": "Calc All Folding Rail Attachment Rate",
            "formatString": "#.#%;(#.#%)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "(calculate(sum(ArTrnDetail[QtyInvoiced]),'4  Set Stock Code Dimensions'[Key Feature]=\"Folding Rail\"))/calculate(sum(ArTrnDetail[QtyInvoiced]),'4  Set Stock Code Dimensions'[Product Class Description]=\"Pinnacle SL\")"
          },
          {
            "name": "Calc B(W) % Units",
            "formatString": "#.#%;(#.#%)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "(sum(ArTrnDetail[2025 Visual Qty])-sum(ArTrnDetail[2024 Visual Qty]))/sum(ArTrnDetail[2024 Visual Qty])"
          },
          {
            "name": "Calc B(W) Folding Rail Attachment Rate",
            "formatString": "#.#%;(#.#%)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "[Calc 2024 Folding Rail Attachment Rate]-[Calc 2023 Folding Rail Attachment Rate]"
          },
          {
            "name": "Calc B(W) Mobility Attachment Rate",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "[Calc Mobility 2024 Attachment Rate]-[Calc Mobility 2023 Attachment Rate]"
          },
          {
            "name": "Calc B(W) Options %",
            "formatString": "#.#%;(#.#%)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "(sum(ArTrnDetail[2024 All Qty])-sum(ArTrnDetail[2023 All Qty]))/sum(ArTrnDetail[2023 All Qty])"
          },
          {
            "name": "Calc B(W) Options",
            "formatString": "#,###;(#,###)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "sum(ArTrnDetail[2024 All Qty])-sum(ArTrnDetail[2023 All Qty])"
          },
          {
            "name": "Calc B(W) SWA Attachment Rate",
            "formatString": "#.#%;(#.#%)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "[Calc 2024 Swing Away Attachment Rate]-[Calc 2023 Swing Away Attachment Rate]"
          },
          {
            "name": "Calc B(W) Units",
            "formatString": "#,###;(#,###)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "sum(ArTrnDetail[2025 Visual Qty])-sum(ArTrnDetail[2024 Visual Qty])"
          },
          {
            "name": "Calc Mobility 2023 Attachment Rate",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "calculate(sum(ArTrnDetail[2023 All Qty]),and('4  Set Stock Code Dimensions'[Product Branch]=\"Mobility\",'4  Set Stock Code Dimensions'[Unit Type]=\"Options & Accessories\"))/calculate(sum(ArTrnDetail[2024 Visual Qty]),'4  Set Stock Code Dimensions'[Product Branch]=\"Mobility\")"
          },
          {
            "name": "Calc Mobility 2024 Attachment Rate",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "calculate(sum(ArTrnDetail[2024 All Qty]),and('4  Set Stock Code Dimensions'[Product Branch]=\"Mobility\",'4  Set Stock Code Dimensions'[Unit Type]=\"Options & Accessories\"))/calculate(sum(ArTrnDetail[2025 Visual Qty]),'4  Set Stock Code Dimensions'[Product Branch]=\"Mobility\")"
          },
          {
            "name": "Calc VPL Height",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "sum(ArTrnDetail[Calc Height])/sum(ArTrnDetail[Calc Qty])"
