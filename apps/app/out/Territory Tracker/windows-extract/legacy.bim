        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "B(W) Unit %",
            "formatString": "#.#%;(#.#%)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "(sum(SorDetail[2024 Units])-sum(SorDetail[2023 Units]))/(sum(SorDetail[2023 Units]))"
          },
          {
            "name": "B(W) Units",
            "formatString": "#;(#)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "sum(SorDetail[2024 Units])-sum(SorDetail[2023 Units])"
          }
        ],
        "columns": [
          {
            "type": "calculated",
            "name": "2023 Units",
            "dataType": "double",
            "isDataTypeInferred": true,
            "formatString": "#,0",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              },
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ],
            "expression": "if(AND(SorDetail[calc 2023 bookings]<>0,SorDetail[Calc Product Unit Type]=\"Whole Good\"),SorDetail[MOrderQty],0)"
          },
          {
            "type": "calculated",
            "name": "2024 Units",
            "dataType": "double",
            "isDataTypeInferred": true,
            "formatString": "#,0",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              },
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ],
            "expression": "if(AND(SorDetail[calc 2025 bookings]<>0,SorDetail[Calc Product Unit Type]=\"Whole Good\"),SorDetail[MOrderQty],0)"
          },
          {
            "type": "calculated",
            "name": "calc 2023 bookings",
            "dataType": "double",
            "isDataTypeInferred": true,
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              },
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "if(year(SorDetail[SorMaster.1.OrderDate])=2023,SorDetail[Visual Bookings Value])"
          },
          {
            "type": "calculated",
            "name": "calc 2025 bookings",
            "dataType": "double",
            "isDataTypeInferred": true,
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "expression": "if(year(SorDetail[SorMaster.1.OrderDate])=2025,SorDetail[Visual Bookings Value])"
          },
          {
            "type": "calculated",
            "name": "calc product unit type",
            "dataType": "string",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "expression": "lookupvalue('Product Dimension'[Unit Type],'Product Dimension'[ProductClass],SorDetail[MProductClass])"
          },
