          {
            "type": "calculated",
            "name": "Calc Height",
            "dataType": "double",
            "isDataTypeInferred": true,
            "formatString": "0",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "expression": "if(ArTrnDetail[StockCode]=\"VPL400\",4,if(ArTrnDetail[StockCode]=\"VPL400-X\",5,if(ArTrnDetail[StockCode]=\"VPL600\",6,if(ArTrnDetail[StockCode]=\"VPL800\",8,if(ArTrnDetail[StockCode]=\"VPL1000\",10,if(ArTrnDetail[StockCode]=\"VPL1200\",12,if(ArTrnDetail[StockCode]=\"VPL1400\",14)))))))*ArTrnDetail[Calc Qty]"
          },
          {
            "type": "calculated",
            "name": "Calc Pinnacle Bandaid",
            "dataType": "string",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "expression": "if(AND(ArTrnDetail[ProductClass]=\"SPIN\",ArTrnDetail[StockCode]<>\"\"),lookupvalue(InvMaster[ProductClass],InvMaster[StockCode],ArTrnDetail[StockCode]),ArTrnDetail[ProductClass])"
          },
          {
            "type": "calculated",
            "name": "Calc Product Unit Type",
            "dataType": "string",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "expression": "lookupvalue('Product Dimension'[Unit Type],'Product Dimension'[ProductClass],ArTrnDetail[ProductClass])"
          },
          {
            "type": "calculated",
            "name": "Calc Qty",
            "dataType": "double",
            "isDataTypeInferred": true,
            "formatString": "#,0",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              },
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ],
            "expression": "if(and(ArTrnDetail[NetSalesValue]<>0,ArTrnDetail[Calc Product Unit Type]=\"Whole Good\"),ArTrnDetail[QtyInvoiced],0)"
          },
