      {
        "name": "Date WDs",
        "partitions": [
          {
            "name": "Date WDs",
            "mode": "import",
            "queryGroup": "Dates",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = SharePoint.Files(\"https://harmar.sharepoint.com/sites/territorytracker\", [ApiVersion = 15]),",
                "    #\"Filtered Rows\" = Table.SelectRows(Source, each ([Name] = \"Periods-Days.xlsx\")),",
                "    #\"Periods-Days xlsx_https://harmar sharepoint com/sites/territorytracker/Shared Documents/General/Slim Shady Files/\" = #\"Filtered Rows\"{[Name=\"Periods-Days.xlsx\",#\"Folder Path\"=\"https://harmar.sharepoint.com/sites/territorytracker/Shared Documents/General/Slim Shady Files/\"]}[Content],",
                "    #\"Imported Excel Workbook\" = Excel.Workbook(#\"Periods-Days xlsx_https://harmar sharepoint com/sites/territorytracker/Shared Documents/General/Slim Shady Files/\"),",
                "    Percent_Through_Table = #\"Imported Excel Workbook\"{[Item=\"Percent_Through\",Kind=\"Table\"]}[Data],",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Percent_Through_Table,{{\"Date\", type date}, {\"Workday\", Int64.Type}, {\"Year\", Int64.Type}, {\"Month #\", Int64.Type}, {\"Month\", type text}, {\"Day\", Int64.Type}, {\"Month & Year\", type text}, {\"WDs Month\", Int64.Type}, {\"WDs Year\", Int64.Type}, {\"% Through Month\", type number}, {\"% Through Year\", type number}}),",
                "    #\"Added Custom\" = Table.AddColumn(#\"Changed Type\", \"PY Date\", each Date.AddYears([Date], 1)),",
                "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Added Custom\",{{\"PY Date\", type date}}),",
                "    #\"Added Custom1\" = Table.AddColumn(#\"Changed Type1\", \"Yesterday\", each Date.AddDays(Date.From(DateTime.LocalNow()), -1)),",
                "    #\"Changed Type2\" = Table.TransformColumnTypes(#\"Added Custom1\",{{\"Yesterday\", type date}}),",
                "    #\"Added Conditional Column\" = Table.AddColumn(#\"Changed Type2\", \"PY Factor\", each if [PY Date] <= [Yesterday] then 1 else 0),",
                "    #\"Changed Type3\" = Table.TransformColumnTypes(#\"Added Conditional Column\",{{\"PY Factor\", Int64.Type}}),",
                "    #\"Removed Other Columns\" = Table.SelectColumns(#\"Changed Type3\",{\"Date\", \"Workday\", \"Year\", \"Month #\", \"Month\", \"Month & Year\"}),",
                "    #\"Reordered Columns\" = Table.ReorderColumns(#\"Removed Other Columns\",{\"Month & Year\", \"Year\", \"Month #\", \"Month\", \"Workday\"}),",
                "    #\"Merged Queries\" = Table.NestedJoin(#\"Reordered Columns\", {\"Month\"}, Months, {\"Month\"}, \"Months\", JoinKind.LeftOuter),",
                "    #\"Expanded Months\" = Table.ExpandTableColumn(#\"Merged Queries\", \"Months\", {\"Quarter\"}, {\"Quarter\"}),",
                "    #\"Duplicated Column\" = Table.DuplicateColumn(#\"Expanded Months\", \"Year\", \"Year - Copy\"),",
                "    #\"Merged Columns\" = Table.CombineColumns(Table.TransformColumnTypes(#\"Duplicated Column\", {{\"Year - Copy\", type text}}, \"en-US\"),{\"Year - Copy\", \"Quarter\"},Combiner.CombineTextByDelimiter(\"-\", QuoteStyle.None),\"Year-Qtr\"),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Merged Columns\",{\"Month & Year\", \"Year\", \"Month #\", \"Month\"}),",
                "    #\"Reordered Columns1\" = Table.ReorderColumns(#\"Removed Columns\",{\"Date\", \"Year-Qtr\", \"Workday\"}),",
                "    #\"Grouped\" =  Table.Group(#\"Reordered Columns1\", {\"Year-Qtr\"}, { {\"Data\", (t as table) as table => let t0 = Table.ReplaceValue(t, null, 0, Replacer.ReplaceValue, {\"Workday\"}), t1 = Table.Sort(t0, {{\"Date\", Order.Ascending}}), t2 = Table.AddIndexColumn(t1, \"__Idx\", 0, 1, Int64.Type), t3 = Table.AddColumn( t2, \"Workday RT\", (r as record) => List.Sum( List.FirstN( t2[Workday], r[__Idx] + 1 ) ), type number ), t4 = Table.RemoveColumns(t3, {\"__Idx\"}) in t4, type table}}),",
                "    #\"Expanded Data\" = Table.ExpandTableColumn(Grouped, \"Data\", {\"Date\", \"Year-Qtr\", \"Workday\", \"Workday RT\"}, {\"Date\", \"Year-Qtr.1\", \"Workday\", \"Workday RT\"})",
                "in",
                "    #\"Expanded Data\""
              ]
            }
