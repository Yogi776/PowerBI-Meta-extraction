        "measures": [
          {
            "name": "Actual vs Forecast Revenue %",
            "formatString": " #,##0.0%;( #,##0.0%)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "iferror( sum('1 Master Table'[Actual Revenue] ) /sum('1 Master Table'[Forecast Revenue]),\"\")"
          },
          {
            "name": "Actual vs Forecast Revenue",
            "formatString": " $#,##0;($#,##0)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "iferror( sum('1 Master Table'[Actual Revenue]) - sum('1 Master Table'[Forecast Revenue]), \"\")"
          },
          {
            "name": "CY vs PY Revenue %",
            "formatString": " #,##0.0%;(#,##0.0%)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "iferror( ( sum('1 Master Table'[CY Revenue]) - sum('1 Master Table'[PY Revenue]) )/ sum('1 Master Table'[PY Revenue] ), \"\")"
          },
          {
            "name": "CY vs PY Revenue",
            "formatString": " $#,##0;($#,##0)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "sum('1 Master Table'[CY Revenue]) - sum( '1 Master Table'[PY Revenue] )"
          },
          {
            "name": "CY vs PYTD Revenue %",
            "formatString": "#,##0.0%;(#,##0.0%)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "iferror( ( sum('1 Master Table'[CY Revenue]) - sum('1 Master Table'[PYTD Revenue]) )/ sum('1 Master Table'[PYTD Revenue] ), \"\")"
          },
          {
            "name": "CY vs PYTD Revenue",
            "formatString": "$#,##0;($#,##0)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "expression": "sum('1 Master Table'[CY Revenue]) - sum( '1 Master Table'[PYTD Revenue] )"
          },
          {
            "name": "Revenue per Unit",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "iferror( sum([Actual Revenue] ) / sum([Actual Units]) , 0 )"
          },
          {
            "name": "Zeros (CY/PY)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "sum('1 Master Table'[CY Revenue] ) + sum('1 Master Table'[PY Revenue]) + sum('1 Master Table'[CY Units]) + sum('1 Master Table'[PY Units])"
          },
          {
            "name": "Zeros (forecast)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "sum('1 Master Table'[Actual Revenue] ) + sum('1 Master Table'[Forecast Revenue]) + sum('1 Master Table'[Actual Units]) + sum('1 Master Table'[Forecast Units])"
          }
        ],
