      {
        "name": "Forecast",
        "partitions": [
          {
            "name": "Forecast",
            "mode": "import",
            "queryGroup": "Forecasts",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = SharePoint.Files(\"https://harmar.sharepoint.com/sites/territorytracker\", [ApiVersion = 15]),",
                "    FilteredFiles = Table.SelectRows(Source, each [Name] = \"2026 Forecast.xlsx\" and [Folder Path] = \"https://harmar.sharepoint.com/sites/territorytracker/Shared Documents/General/Slim Shady Files/\"),",
                "    FileBinary = FilteredFiles{0}[Content],",
                "    ImportedWorkbook = Excel.Workbook(FileBinary),",
                "    Revenue_Table = ImportedWorkbook{[Item=\"Revenue\",Kind=\"Table\"]}[Data],",
                "    #\"Changed Type2\" = Table.TransformColumnTypes(Revenue_Table,{{\"Territory\", type text}}),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Changed Type2\",{\"Proportion\", \"Key Account & OE\"}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Removed Columns\",{{\"Key Account & Territory\", \"Name\"}}),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Renamed Columns\",{{\"2026-12\", type number}, {\"2026-11\", type number}, {\"2026-10\", type number}, {\"2026-09\", type number}, {\"2026-08\", type number}, {\"2026-07\", type number}, {\"2026-06\", type number}, {\"2026-05\", type number}, {\"2026-04\", type number}, {\"2026-03\", type number}, {\"2026-02\", type number}, {\"2026-01\", type number}, {\"2025-12\", type number}, {\"2025-11\", type number}, {\"2025-10\", type number}, {\"2025-09\", type number}}),",
                "    #\"Unpivoted Columns\" = Table.UnpivotOtherColumns(#\"Changed Type\", {\"Name\", \"Sub_Key_Account__c\", \"Organizational Element\", \"Revenue GL Code\", \"ProductUnitType\", \"Territory\"}, \"Attribute\", \"Value\"),",
                "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Unpivoted Columns\",{{\"Name\", type text}, {\"Sub_Key_Account__c\", type text}, {\"Organizational Element\", type text}, {\"Revenue GL Code\", type text}, {\"ProductUnitType\", type text}}),",
                "    #\"Renamed Columns1\" = Table.RenameColumns(#\"Changed Type1\",{{\"Attribute\", \"Year-Month\"}}),",
                "    #\"Appended Query\" = Table.Combine({#\"Renamed Columns1\", Units}),",
                "    #\"Removed Columns1\" = Table.RemoveColumns(#\"Appended Query\",{\"Territory\"}),",
                "    #\"Merged Columns\" = Table.CombineColumns(#\"Removed Columns1\",{\"Name\", \"Sub_Key_Account__c\", \"Organizational Element\", \"Revenue GL Code\", \"ProductUnitType\", \"Year-Month\"},Combiner.CombineTextByDelimiter(\"|\", QuoteStyle.None),\"Merged\"),",
                "    #\"Grouped Rows\" = Table.Group(#\"Merged Columns\", {\"Merged\"}, {{\"Value\", each List.Sum([Value]), type nullable number}, {\"Wholegood Units\", each List.Sum([Wholegood Units]), type nullable number}}),",
                "    #\"Split Column by Delimiter\" = Table.SplitColumn(#\"Grouped Rows\", \"Merged\", Splitter.SplitTextByDelimiter(\"|\", QuoteStyle.Csv), {\"Merged.1\", \"Merged.2\", \"Merged.3\", \"Merged.4\", \"Merged.5\", \"Merged.6\", \"Merged.7\"}),",
                "    #\"Merged Columns1\" = Table.CombineColumns(Table.TransformColumnTypes(#\"Split Column by Delimiter\", {{\"Merged.2\", type text}}, \"en-US\"),{\"Merged.1\", \"Merged.2\"},Combiner.CombineTextByDelimiter(\"|\", QuoteStyle.None),\"Name\"),",
                "    #\"Renamed Columns2\" = Table.RenameColumns(#\"Merged Columns1\",{{\"Merged.3\", \"Sub_Key_Account__c\"}, {\"Merged.4\", \"Organizational Element\"}, {\"Merged.5\", \"Revenue GL Code\"}, {\"Merged.6\", \"ProductUnitType\"}, {\"Merged.7\", \"Year-Month\"}}),",
                "    #\"Changed Type3\" = Table.TransformColumnTypes(#\"Renamed Columns2\",{{\"Wholegood Units\", Int64.Type}}),",
                "    #\"Replaced Value\" = Table.ReplaceValue(#\"Changed Type3\",\"OTO\",\"OTOLift\",Replacer.ReplaceText,{\"Organizational Element\"}),",
                "    #\"Replaced Value1\" = Table.ReplaceValue(#\"Replaced Value\",\"PIN2\",\"Pinnacle 2.0\",Replacer.ReplaceText,{\"Organizational Element\"}),",
                "    #\"Merged Queries\" = Table.NestedJoin(#\"Replaced Value1\", {\"Organizational Element\"}, #\"Organizational Elements (De-Duplicated)\", {\"Organizational Element\"}, \"Organizational Elements (De-Duplicated)\", JoinKind.LeftOuter),",
                "    #\"Expanded Organizational Elements (De-Duplicated)\" = Table.ExpandTableColumn(#\"Merged Queries\", \"Organizational Elements (De-Duplicated)\", {\"OE Group\"}, {\"OE Group\"}),",
                "    #\"Renamed Columns3\" = Table.RenameColumns(#\"Expanded Organizational Elements (De-Duplicated)\",{{\"Value\", \"Forecast Revenue\"}, {\"Wholegood Units\", \"Forecast Units\"}}),",
                "    #\"Merged Queries1\" = Table.NestedJoin(#\"Renamed Columns3\", {\"OE Group\"}, Channel, {\"Standard Account Revenue 2025-01 to 2025-08\"}, \"Channel\", JoinKind.LeftOuter),",
                "    #\"Expanded Channel\" = Table.ExpandTableColumn(#\"Merged Queries1\", \"Channel\", {\"VA %\"}, {\"VA %\"}),",
                "    #\"Changed Type4\" = Table.TransformColumnTypes(#\"Expanded Channel\",{{\"VA %\", type number}}),",
                "    #\"Added Conditional Column\" = Table.AddColumn(#\"Changed Type4\", \"VA%\", each if [Sub_Key_Account__c] = \"Standard Account\" then [#\"VA %\"] else 0),",
                "    #\"Changed Type5\" = Table.TransformColumnTypes(#\"Added Conditional Column\",{{\"VA%\", type number}}),",
                "    FilteredFinal = Table.SelectRows(#\"Changed Type5\", each true),",
                "    #\"Removed Columns2\" = Table.RemoveColumns(FilteredFinal,{\"VA %\"}),",
                "    #\"Inserted Multiplication\" = Table.AddColumn(#\"Removed Columns2\", \"Multiplication\", each List.Product({[Forecast Revenue], [#\"VA%\"]}), type number),",
                "    #\"Rounded Off\" = Table.TransformColumns(#\"Inserted Multiplication\",{{\"Multiplication\", each Number.Round(_, 2), type number}}),",
                "    #\"Added Custom\" = Table.AddColumn(#\"Rounded Off\", \"Non-VA\", each [Forecast Revenue]-[Multiplication]),",
                "    #\"Renamed Columns4\" = Table.RenameColumns(#\"Added Custom\",{{\"Multiplication\", \"VA\"}}),",
                "    #\"Changed Type6\" = Table.TransformColumnTypes(#\"Renamed Columns4\",{{\"Non-VA\", type number}}),",
                "    #\"Rounded Off1\" = Table.TransformColumns(#\"Changed Type6\",{{\"Non-VA\", each Number.Round(_, 2), type number}}),",
                "    #\"Inserted Multiplication1\" = Table.AddColumn(#\"Rounded Off1\", \"Multiplication\", each List.Product({[Forecast Units], [#\"VA%\"]}), type number),",
                "    #\"Rounded Off2\" = Table.TransformColumns(#\"Inserted Multiplication1\",{{\"Multiplication\", each Number.Round(_, 0), type number}}),",
                "    #\"Renamed Columns5\" = Table.RenameColumns(#\"Rounded Off2\",{{\"Multiplication\", \"VA Units\"}}),",
                "    #\"Added Custom1\" = Table.AddColumn(#\"Renamed Columns5\", \"Non-VA Units\", each [Forecast Units]-[VA Units]),",
                "    #\"Changed Type7\" = Table.TransformColumnTypes(#\"Added Custom1\",{{\"VA Units\", Int64.Type}, {\"Non-VA Units\", Int64.Type}}),",
                "    #\"Removed Columns3\" = Table.RemoveColumns(#\"Changed Type7\",{\"Forecast Revenue\", \"Forecast Units\", \"VA%\"}),",
                "    #\"Merged Columns2\" = Table.CombineColumns(#\"Removed Columns3\",{\"Name\", \"Sub_Key_Account__c\", \"Organizational Element\", \"Revenue GL Code\", \"ProductUnitType\", \"Year-Month\", \"OE Group\"},Combiner.CombineTextByDelimiter(\"~\", QuoteStyle.None),\"Merged\"),",
                "    #\"Unpivoted Columns1\" = Table.UnpivotOtherColumns(#\"Merged Columns2\", {\"Merged\"}, \"Attribute\", \"Value\"),",
                "    #\"Duplicated Column\" = Table.DuplicateColumn(#\"Unpivoted Columns1\", \"Attribute\", \"Attribute - Copy\"),",
                "    #\"Split Column by Delimiter1\" = Table.SplitColumn(#\"Duplicated Column\", \"Attribute - Copy\", Splitter.SplitTextByEachDelimiter({\" \"}, QuoteStyle.Csv, true), {\"Attribute - Copy.1\", \"Attribute - Copy.2\"}),",
                "    #\"Changed Type8\" = Table.TransformColumnTypes(#\"Split Column by Delimiter1\",{{\"Attribute - Copy.1\", type text}, {\"Attribute - Copy.2\", type text}}),",
                "    #\"Added Custom2\" = Table.AddColumn(#\"Changed Type8\", \"Forecast Units\", each if [#\"Attribute - Copy.2\"] = \"Units\" then [Value] else 0),",
                "    #\"Changed Type9\" = Table.TransformColumnTypes(#\"Added Custom2\",{{\"Forecast Units\", Int64.Type}}),",
                "    #\"Added Custom3\" = Table.AddColumn(#\"Changed Type9\", \"Forecast Revenue\", each [Value] - [Forecast Units]),",
                "    #\"Changed Type10\" = Table.TransformColumnTypes(#\"Added Custom3\",{{\"Forecast Revenue\", type number}}),",
                "    #\"Removed Columns4\" = Table.RemoveColumns(#\"Changed Type10\",{\"Attribute\", \"Value\", \"Attribute - Copy.2\"}),",
                "    #\"Merged Columns3\" = Table.CombineColumns(#\"Removed Columns4\",{\"Merged\", \"Attribute - Copy.1\"},Combiner.CombineTextByDelimiter(\"~\", QuoteStyle.None),\"Merged.1\"),",
                "    #\"Grouped Rows1\" = Table.Group(#\"Merged Columns3\", {\"Merged.1\"}, {{\"Forecast Revenue\", each List.Sum([Forecast Revenue]), type nullable number}, {\"Forecast Units\", each List.Sum([Forecast Units]), type nullable number}}),",
                "    #\"Changed Type11\" = Table.TransformColumnTypes(#\"Grouped Rows1\",{{\"Forecast Units\", Int64.Type}}),",
                "    #\"Split Column by Delimiter2\" = Table.SplitColumn(#\"Changed Type11\", \"Merged.1\", Splitter.SplitTextByDelimiter(\"~\", QuoteStyle.Csv), {\"Name\", \"Sub_Key_Account__c\", \"Organizational Element\", \"Revenue GL Code\", \"ProductUnitType\", \"Year-Month\", \"OE Group\", \"Channel\"}),",
                "    #\"Changed Type12\" = Table.TransformColumnTypes(#\"Split Column by Delimiter2\",{{\"Name\", type text}, {\"Sub_Key_Account__c\", type text}, {\"Organizational Element\", type text}, {\"Revenue GL Code\", type text}, {\"ProductUnitType\", type text}, {\"Year-Month\", type text}, {\"OE Group\", type text}, {\"Channel\", type text}}),",
                "    #\"Duplicated Column1\" = Table.DuplicateColumn(#\"Changed Type12\", \"Year-Month\", \"Year-Month - Copy\"),",
                "    #\"Reordered Columns\" = Table.ReorderColumns(#\"Duplicated Column1\",{\"Year-Month - Copy\", \"Name\", \"Sub_Key_Account__c\", \"Organizational Element\", \"Revenue GL Code\", \"ProductUnitType\", \"Year-Month\", \"OE Group\", \"Channel\", \"Forecast Revenue\", \"Forecast Units\"}),",
                "    #\"Changed Type13\" = Table.TransformColumnTypes(#\"Reordered Columns\",{{\"Year-Month - Copy\", type date}}),",
                "    #\"Renamed Columns6\" = Table.RenameColumns(#\"Changed Type13\",{{\"Year-Month - Copy\", \"Date\"}}),",
                "    #\"Changed Type14\" = Table.TransformColumnTypes(#\"Renamed Columns6\",{{\"Date\", type text}})",
                "in",
                "    #\"Changed Type14\""
              ]
            }
          }
        ],
